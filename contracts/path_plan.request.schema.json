{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awaken.app/contracts/path_plan.request.schema.json",
  "title": "PLAN_PATH request (GAME_DESIGN §6.6.1-6.6.2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "path", "constraints"],
  "properties": {
    "requestId": { "$ref": "#/$defs/uuid" },
    "path": { "$ref": "#/$defs/path" },
    "constraints": { "$ref": "#/$defs/constraints" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "stat": { "enum": ["STR", "INT", "WIL", "VIT", "CHA"] },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "currentLevel", "notes", "primaryStat", "activeDays", "questsPerDay", "weeklyMinutes"],
      "properties": {
        "goal": { "type": "string", "minLength": 3, "maxLength": 120 },
        "currentLevel": { "type": "string", "maxLength": 120 },
        "notes": { "type": "string", "maxLength": 280 },
        "primaryStat": { "$ref": "#/$defs/stat" },
        "secondaryStat": { "anyOf": [{ "$ref": "#/$defs/stat" }, { "type": "null" }] },
        "activeDays": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "enum": ["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"] }
        },
        "questsPerDay": { "type": "integer", "minimum": 1, "maximum": 2 },
        "weeklyMinutes": { "type": "integer", "minimum": 30, "maximum": 900 }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["equipment", "injuryTags"],
      "properties": {
        "equipment": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 7,
          "items": {
            "enum": ["dumbbells", "kettlebell", "pullup_bar", "resistance_band", "jump_rope", "gym_access", "bicycle"]
          }
        },
        "injuryTags": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 3,
          "items": { "enum": ["impact", "legs", "upper"] }
        }
      }
    }
  }
}
