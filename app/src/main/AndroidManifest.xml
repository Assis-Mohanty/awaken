<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- AI Paths: the Path Oracle proxy is the only network destination (CLAUDE.md invariant 8); cleartext is disabled. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Focus Gate countdown and "return to claim" notifications (ARCH §3.3). Requested when a gate opens. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Health Connect (ARCH §3.4): read-only. Core: steps, exercise, sleep. Optional: distance, active calories, heart rate. No background-read permission. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />

    <!-- Phone step counter (Recording API on mobile), asked for only when the hunter taps "Count steps on this phone". -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Screen Discipline (ARCH §3.11): read-only usage access the hunter grants in system settings. Never blocks apps. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <!-- Launcher apps only, for the Screen Time list's names and icons (no QUERY_ALL_PACKAGES). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Focus Lock: finds this phone's launcher so it is never covered. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".AwakenApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AWAKEN">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AWAKEN.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Focus Lock (GD 8.2): window-change events only, package name only. Opt-in in Android Accessibility settings. -->
        <service
            android:name=".core.lock.FocusLockService"
            android:exported="true"
            android:label="@string/focus_lock_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/focus_lock_service" />
        </service>

        <!-- Privacy policy shown by Health Connect's permission screens (Android 13 and lower). -->
        <activity
            android:name=".feature.settings.PrivacyPolicyActivity"
            android:exported="true"
            android:theme="@style/Theme.AWAKEN">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- The same screen for Health Connect on Android 14 and higher. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".feature.settings.PrivacyPolicyActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Today widget (ARCH §3.6). -->
        <receiver
            android:name=".core.widget.TodayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <!-- Focus widget: today's focus time and a running session. -->
        <receiver
            android:name=".core.widget.FocusWidgetReceiver"
            android:exported="true"
            android:label="@string/focus_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/focus_widget_info" />
        </receiver>

        <!-- WorkManager is configured by AwakenApp (Hilt worker factory), so its default initializer is removed. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Hands the Weekly Report share image to ACTION_SEND targets (read grant per share, cache only). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
    </application>

</manifest>