    <!-- Pause settings -->
    <string name="pause_title">Pause</string>
    <string name="pause_subtitle">A short breath before the apps you choose open.</string>
    <string name="pause_switch_title">Pause chosen apps</string>
    <string name="pause_switch_note">Shows a short pause before an app you chose opens. Pausing earns nothing and costs nothing.</string>
    <string name="pause_apps_title">Apps</string>
    <string name="pause_apps_none">No apps chosen yet</string>
    <plurals name="pause_apps_count">
        <item quantity="one">%1$d app chosen</item>
        <item quantity="other">%1$d apps chosen</item>
    </plurals>
    <string name="pause_apps_open">Choose apps</string>
    <string name="pause_delay_title">Pause length</string>
    <string name="pause_delay_value">%1$d seconds</string>
    <string name="pause_progressive_title">Longer each time</string>
    <string name="pause_progressive_note">Adds 2 seconds each time you open the same app today, up to 15 seconds.</string>
    <string name="pause_cooldown_title">Quiet time after you continue</string>
    <string name="pause_cooldown_note">Off means the pause comes every time you open the app. Otherwise it stays quiet for this long after you continue.</string>
    <string name="pause_cooldown_off">Off</string>
    <string name="pause_cooldown_value">%1$d min</string>
    <string name="pause_require_tap_title">Tap to continue</string>
    <string name="pause_require_tap_note">Wait for a tap instead of opening the app when the pause ends.</string>
    <string name="pause_intention_setting_title">Ask what it\'s for</string>
    <string name="pause_intention_setting_note">Shows a few choices on the pause screen. Your answers stay on this phone and only feed your stats.</string>
    <string name="pause_hours_title">Only at certain times</string>
    <string name="pause_hours_note">Pause stays off outside this window.</string>
    <string name="pause_hours_from">From</string>
    <string name="pause_hours_to">To</string>
    <string name="pause_hours_label">%1$02d:00</string>
    <string name="pause_day_mon">Mon</string>
    <string name="pause_day_tue">Tue</string>
    <string name="pause_day_wed">Wed</string>
    <string name="pause_day_thu">Thu</string>
    <string name="pause_day_fri">Fri</string>
    <string name="pause_day_sat">Sat</string>
    <string name="pause_day_sun">Sun</string>
    <string name="pause_stats_open">See the last 7 days</string>
    <string name="pause_setup_title">Before Pause can work</string>
    <string name="pause_disclosure">Pause needs two permissions. Usage access lets AWAKEN see which app is open, so it knows when one of your chosen apps starts. Appear on top lets it show the pause screen over that app. AWAKEN reads the app\'s name only, keeps your pause counts on this phone, and sends nothing anywhere.</string>
    <string name="pause_perm_usage">Usage access</string>
    <string name="pause_perm_overlay">Appear on top</string>
    <string name="pause_perm_notifications">Notifications</string>
    <string name="pause_perm_popup">Pop-ups while other apps are open</string>
    <string name="pause_perm_popup_note">Your phone may need this switched on in its own app settings, or the pause screen can\'t open from the background.</string>
    <string name="pause_ready">Pause is watching.</string>
    <string name="pause_not_ready">Pause starts once usage access and appearing on top are on, and at least one app is chosen.</string>

