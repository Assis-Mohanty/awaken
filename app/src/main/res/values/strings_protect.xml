    <!-- Lockdown (GD 19.2): a focus session with no early end. -->
    <string name="lockdown_title">Lockdown</string>
    <string name="lockdown_subtitle">A focus session with no early end.</string>
    <string name="lockdown_window_note">Lock your phone to a few apps for a set time.</string>
    <string name="lockdown_window_start">Start a Lockdown</string>
    <string name="lockdown_window_running">A Lockdown is running</string>
    <string name="lockdown_window_cooldown">Next Lockdown in %1$d min</string>
    <string name="lockdown_length_title">How long?</string>
    <string name="lockdown_minutes">%1$d min</string>
    <string name="lockdown_shorter">Shorter</string>
    <string name="lockdown_longer">Longer</string>
    <string name="lockdown_apps_title">Apps you can still use</string>
    <string name="lockdown_apps_note">Choose up to 3. Calls, messages, payments and Settings always work. Social, video, game and distracting apps can\'t be allowed.</string>
    <string name="lockdown_apps_search">Search apps</string>
    <string name="lockdown_apps_full">You have chosen 3 apps. Remove one to add another.</string>
    <string name="lockdown_app_always">Always works</string>
    <string name="lockdown_app_blocked">Can\'t be allowed</string>
    <string name="lockdown_disclosure">Lockdown uses usage access to see which app is open, and appear on top to cover the others. It reads the app\'s name only, keeps nothing but the session, and sends nothing anywhere.</string>
    <string name="lockdown_continue">Continue</string>
    <string name="lockdown_needs_permissions">Turn on usage access and appear on top first.</string>
    <string name="lockdown_wait_message">You can start another Lockdown in %1$d min.</string>
    <string name="lockdown_not_allowed_message">%1$s can\'t be allowed during a Lockdown.</string>
    <string name="lockdown_too_late_message">That is too long for what is left of today. Choose a shorter time.</string>
    <string name="lockdown_busy_message">Another focus session is already running.</string>
    <string name="lockdown_confirm_title">Before you start</string>
    <string name="lockdown_confirm_body">For %1$d minutes, every app except the ones you chose is covered. There is no end button. Calls, messages, payments and Settings still work. If you leave through the emergency exit, the session earns nothing and you can\'t start another Lockdown for an hour.</string>
    <string name="lockdown_confirm_start">I understand, start</string>
    <string name="lockdown_confirm_back">Back</string>
    <string name="lockdown_left">%1$s left</string>
    <string name="lockdown_session_apps">Apps you can use</string>
    <string name="lockdown_session_no_apps">No apps chosen. Only calls, messages and payments.</string>
    <string name="lockdown_exit_title">Emergency exit</string>
    <string name="lockdown_exit_note">Hold for 3 seconds, then wait 1 minute on this screen. The session ends with no reward, and the next Lockdown can start in 1 hour.</string>
    <string name="lockdown_exit_hold">Hold to start</string>
    <string name="lockdown_exit_holding">Keep holding</string>
    <string name="lockdown_exit_waiting">Ending in %1$d s. Stay on this screen.</string>
    <string name="cd_lockdown_exit">Emergency exit. Double tap and hold for 3 seconds.</string>
    <string name="lockdown_block_left">Lockdown · %1$s left</string>
    <string name="lockdown_block_unavailable">%1$s isn\'t available right now.</string>
    <string name="lockdown_block_back">Back to session</string>
    <string name="lockdown_done_title">Lockdown complete</string>
    <string name="lockdown_done_body">You stayed with it for %1$d minutes. It counts as a focus session.</string>
    <string name="lockdown_broken_title">Lockdown ended early</string>
    <string name="lockdown_broken_exit">You used the emergency exit.</string>
    <string name="lockdown_broken_permission">A permission was turned off, so Lockdown could not keep covering apps.</string>
    <string name="lockdown_broken_uncovered">Lockdown stopped watching for too long.</string>
    <string name="lockdown_broken_note">No reward. You can start another one in 1 hour.</string>
    <string name="lockdown_broken_detail">Lockdown ended early. No reward.</string>
    <string name="lockdown_done_button">Done</string>
    <string name="lockdown_notif_title">Lockdown</string>
    <string name="lockdown_notif_body">No early end. Calls, messages and payments still work.</string>
    <string name="lockdown_notif_done_body">You stayed with it. It counts as a focus session.</string>
