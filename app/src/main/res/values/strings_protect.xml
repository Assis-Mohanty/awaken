    <string name="protect_notif_turn_off">Turn off</string>
    <string name="focus_lock_notif_title">Focus session in progress</string>
    <string name="focus_lock_notif_body">AWAKEN covers other apps until the session ends. Nothing is saved or sent anywhere.</string>
    <string name="protect_not_started_title">AWAKEN can\'t watch right now</string>
    <string name="protect_not_started_body">Your phone stopped it from starting in the background. Open AWAKEN to start it again.</string>

