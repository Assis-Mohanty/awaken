    <!-- The line bank (PZ10): reflective questions and plain observations. -->
    <string name="pause_line_01">What did you come here for?</string>
    <string name="pause_line_02">Is this the thing you meant to do?</string>
    <string name="pause_line_03">One breath, then choose.</string>
    <string name="pause_line_04">You can still go on. You can also stop.</string>
    <string name="pause_line_05">What would you like to be doing in ten minutes?</string>
    <string name="pause_line_06">Notice what you\'re reaching for.</string>
    <string name="pause_line_07">Is this a choice, or a habit?</string>
    <string name="pause_line_08">Take a slow breath in, and let it out.</string>
    <string name="pause_line_09">What is the next small thing you want to finish?</string>
    <string name="pause_line_10">You opened this on purpose. Check that it\'s still on purpose.</string>
    <string name="pause_line_11">How are you feeling right now?</string>
    <string name="pause_line_12">Who or what are you looking for?</string>
    <string name="pause_line_13">A moment to decide is still your decision.</string>
    <string name="pause_line_14">Is there something you\'ve been putting off?</string>
    <string name="pause_line_15">You\'re in charge of this next minute.</string>
    <string name="pause_line_16">Check your shoulders. Let them drop.</string>
    <string name="pause_line_17">What would be a good use of the next few minutes?</string>
    <string name="pause_line_18">Open it if it helps. Close it if it doesn\'t.</string>
    <string name="pause_line_19">Where is your attention going?</string>
    <string name="pause_line_20">Pause here. Then do what you meant to do.</string>
    <string name="pause_line_21">You don\'t have to scroll to rest.</string>
    <string name="pause_line_22">What are you hoping to find?</string>
    <string name="pause_line_23">Take your time. The app will wait.</string>
    <string name="pause_line_24">Is anyone waiting on you for something else?</string>
    <string name="pause_line_25">A breath first.</string>
    <string name="pause_line_26">Would a short walk help more?</string>
    <string name="pause_line_27">What did you plan to do today?</string>
    <string name="pause_line_28">Have a drink of water, then decide.</string>
    <string name="pause_line_29">Still want to go in? That\'s fine.</string>
    <string name="pause_line_30">Notice how your body feels right now.</string>
    <string name="pause_line_31">How long do you want to spend here?</string>
    <string name="pause_line_32">Set a number in your head before you start.</string>
    <string name="pause_line_33">What needs your attention more than this?</string>
    <string name="pause_line_34">Is this tired, bored or curious?</string>
    <string name="pause_line_35">You can come back to this later.</string>
    <string name="pause_line_36">One thing at a time.</string>
    <string name="pause_line_37">Going in with a plan is different from drifting in.</string>
    <string name="pause_line_38">What would you tell a friend in your place?</string>
    <string name="pause_line_39">Pause. Look up. Then go on.</string>
    <string name="pause_line_40">Is this where you want your next hour to go?</string>
