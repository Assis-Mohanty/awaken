    <!-- Pause (GD 19.1): a short breath before the apps you choose open. Plain words; no game terms. -->

    <!-- Notification -->
    <string name="protect_channel_name">Pause</string>
    <string name="protect_channel_description">Shows while Pause is watching for the apps you chose.</string>
    <string name="protect_notif_title">Pause is on</string>
    <string name="protect_notif_body">AWAKEN notices when one of your chosen apps opens. Nothing is saved or sent anywhere.</string>
    <string name="protect_notif_turn_off">Turn off</string>

