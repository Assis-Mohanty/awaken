<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light palette (values-night holds the premium-black twin). windowBackground = void so there is no flash before Compose draws. -->
    <style name="Theme.AWAKEN" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/void_background</item>
    </style>

    <!-- Launch theme (core-splashscreen); MainActivity swaps to Theme.AWAKEN via installSplashScreen(). Brand-black in both modes. -->
    <style name="Theme.AWAKEN.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_gate</item>
        <item name="postSplashScreenTheme">@style/Theme.AWAKEN</item>
    </style>
</resources>
