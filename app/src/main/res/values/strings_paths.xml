    <!-- AI consent sheet (DESIGN_SYSTEM §4.8) -->
    <string name="consent_title">THE ORACLE</string>
    <string name="consent_headline">The System needs to consult the Oracle.</string>
    <string name="consent_body">To write your Path, AWAKEN sends your goal, current level, notes, and last week\'s quest results to our AI provider. No name, no account, no health data. Our server doesn\'t store it.</string>
    <string name="consent_rewards">Rewards are always calculated on your phone by fixed rules. The AI only writes the quests.</string>
    <string name="consent_enable">Enable AI Paths</string>
    <string name="consent_not_now">Not now</string>
    <string name="consent_what_is_sent">What exactly is sent?</string>
    <string name="consent_sent_title">Sent with each request</string>
    <string name="consent_sent_1">Your goal, current level and notes, as you typed them</string>
    <string name="consent_sent_2">Your primary and second stat, active days, quests per day and weekly minutes</string>
    <string name="consent_sent_3">The current and next milestone titles, and how last week went (quest titles, done or not, your feedback)</string>
    <string name="consent_sent_4">The equipment you own and your Injury Mode tags, so quests avoid them</string>
    <string name="consent_not_sent">Never sent: XP, level, gold, streak, Health Connect data, your name, or any device identifier beyond a random install ID.</string>

