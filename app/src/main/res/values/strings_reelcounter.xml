    <!-- Limits -->
    <string name="reel_limits_title">Reel limits</string>
    <string name="reel_limits_subtitle">A reminder when you reach a limit</string>
    <string name="reel_limits_note">When you reach a limit you get a reminder, with 5 more reels up to twice a day. Limits are off until you set one.</string>
    <string name="reel_block_title">Block short videos</string>
    <string name="reel_block_subtitle">Press Back on the short-video screens of the apps you pick.</string>
    <string name="reel_block_disclosure_title">Before you turn this on</string>
    <string name="reel_block_disclosure">This uses the Accessibility service, which you already allow for the reel counter. It looks only at the names of on-screen views to tell when a short-video screen is open. It never reads text, messages or passwords, and nothing leaves your phone. When a short-video screen of an app you picked is open, AWAKEN presses Back for you, at most once a second. If the screen is still there after two Backs it goes to your home screen. The rest of the app is not touched. You can turn it off here or in Android settings at any time.</string>
    <string name="reel_block_agree">I understand, continue</string>
    <string name="reel_block_when">When to block</string>
    <string name="reel_block_mode_off">Never</string>
    <string name="reel_block_mode_sessions">During focus sessions and Lockdown</string>
    <string name="reel_block_mode_always">Always</string>
    <string name="reel_block_apps">Apps to block</string>
    <string name="reel_block_note">Blocking needs the reel counter switched on. It only acts on apps whose screens have been checked on this phone.</string>
    <string name="reel_block_open">Block short videos</string>
    <string name="reel_study_title">Study mode</string>
    <string name="reel_study_subtitle">On YouTube, only watch channels on your list.</string>
    <string name="reel_study_disclosure_title">Before you turn this on</string>
    <string name="reel_study_disclosure">This uses the Accessibility service. When you open a YouTube video, AWAKEN reads one thing on the screen: the channel name under the video. It checks the name against your list on this phone and then forgets it. The name is never saved, logged or sent anywhere, and nothing else on the screen is read. If the channel is not on your list, AWAKEN presses Back. If it cannot read the name, the video plays. Study mode only runs while a focus session or Lockdown is running.</string>
    <string name="reel_study_agree">I understand, continue</string>
    <string name="reel_study_switch">Study mode</string>
    <string name="reel_study_locked">The list is locked while Study mode is on. Turn it off to change it.</string>
    <string name="reel_study_list">Channels you allow</string>
    <string name="reel_study_empty">No channels yet. Every YouTube video will be blocked until you add one.</string>
    <string name="reel_study_remove">Remove</string>
    <string name="reel_study_add_prompt">Add a channel</string>
    <string name="reel_study_add">Add channel</string>
    <string name="reel_study_note">Type the name shown under the video. A channel whose handle differs from its name will not match. Study mode only works once this phone’s YouTube screens have been checked.</string>
