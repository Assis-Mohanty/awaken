<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup policy: the Room ledger and UI prefs survive a new phone (no account exists to restore from).
   ai_prefs (install ID, AI consent) and notices (one-shot System notices) are device-specific and never leave the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/ui_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/ui_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
