<?xml version="1.0" encoding="utf-8"?>
<!--
  Focus Lock (GAME_DESIGN §8.2): window-change events only, no screen content, no gestures, no key events.
  canRetrieveWindowContent stays false on purpose; the service can see which app came to the front and nothing else.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/focus_lock_service_description"
    android:notificationTimeout="100" />
