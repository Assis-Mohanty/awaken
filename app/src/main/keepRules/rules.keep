# AWAKEN R8 keep rules. AGP combines all files in src/main/keepRules.
# Hilt, Room, Navigation, Compose and kotlinx.serialization ship consumer rules; these cover our own code.

# --- kotlinx.serialization ---
# Keep generated serializers for our @Serializable classes (nav routes, template/content models, export JSON).
-keepattributes *Annotation*, InnerClasses
-dontnote kotlinx.serialization.**
-keep,includedescriptorclasses class com.assismohanty.awaken.**$$serializer { *; }
-keepclassmembers class com.assismohanty.awaken.** {
    *** Companion;
}
-keepclasseswithmembers class com.assismohanty.awaken.** {
    kotlinx.serialization.KSerializer serializer(...);
}
# @Serializable objects (type-safe nav routes are data objects).
-keepclassmembers @kotlinx.serialization.Serializable class com.assismohanty.awaken.** {
    public static ** INSTANCE;
}

# --- Room ---
# Generated *_Impl classes are instantiated reflectively by Room.databaseBuilder.
-keep class * extends androidx.room.RoomDatabase { <init>(); }
-keep @androidx.room.Entity class com.assismohanty.awaken.** { *; }

# --- Hilt ---
# Hilt's consumer rules cover generated components; keep our application entry point explicit.
-keep class com.assismohanty.awaken.AwakenApp

# --- Timber ---
# Strip verbose/debug logs from release (DebugTree is only planted in debug anyway).
-assumenosideeffects class timber.log.Timber {
    public static void v(...);
    public static void d(...);
}
