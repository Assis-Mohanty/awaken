{
  "name": "AWAKEN Plates",
  "version": "1.1",
  "notes": "Semantic roles only. Feature code reads these roles, never a raw value. dp and sp units.",
  "color": {
    "light": {
      "bg": "#F2F2ED",
      "surface": "#FDFDFB",
      "surfaceSunken": "#E6E7E1",
      "ink": "#16171B",
      "inkMuted": "#50545B",
      "line": "#DCDDD7",
      "primary": "#16171B",
      "onPrimary": "#FDFDFB",
      "scrim": "#0A0A0C8F",
      "critical": "#B81B21"
    },
    "dark": {
      "bg": "#131417",
      "surface": "#1E1F23",
      "surfaceSunken": "#2B2C31",
      "ink": "#F2F2EC",
      "inkMuted": "#B6B8BD",
      "line": "#2E2F35",
      "primary": "#F2F2EC",
      "onPrimary": "#16171B",
      "scrim": "#0A0A0C8F",
      "critical": "#E5635C"
    },
    "stat": {
      "light": {
        "strength": "#C4382F",
        "intelligence": "#2C63C2",
        "willpower": "#DDA92C",
        "vitality": "#2A8E66",
        "charisma": "#FFFFFF",
        "charismaEdge": "#C9CBC4"
      },
      "dark": {
        "strength": "#E5635C",
        "intelligence": "#6E9CEE",
        "willpower": "#E9C25C",
        "vitality": "#57BF90",
        "charisma": "#E9E8E0",
        "charismaEdge": "#E9E8E0"
      }
    },
    "field": {
      "note": "Full-screen session colour. Text and the dial are always white.",
      "light": {
        "intelligence": "#1B3F86",
        "strength": "#8E2A25",
        "vitality": "#1D5F47"
      },
      "dark": {
        "intelligence": "#142D5F",
        "strength": "#5E1C19",
        "vitality": "#123F2F"
      },
      "dialTrack": "#FFFFFF29",
      "action": {
        "bg": "#FDFDFB",
        "ink": "#16171B"
      }
    }
  },
  "typography": {
    "family": "Archivo (variable, SIL OFL): axes wdth 62-125, wght 100-900",
    "styles": {
      "display": {
        "sizeSp": 76,
        "weight": 600,
        "width": 100,
        "tracking": -0.04,
        "use": "Clock inside the session dial"
      },
      "metricXL": {
        "sizeSp": 84,
        "weight": 600,
        "width": 104,
        "tracking": -0.045,
        "use": "Onboarding value"
      },
      "metricL": {
        "sizeSp": 72,
        "weight": 600,
        "width": 104,
        "tracking": -0.045,
        "use": "Current set"
      },
      "metricM": {
        "sizeSp": 54,
        "weight": 600,
        "width": 104,
        "tracking": -0.045,
        "use": "Screen hero number"
      },
      "metricS": {
        "sizeSp": 26,
        "weight": 650,
        "width": 100,
        "tracking": -0.03,
        "use": "Level in the small ring"
      },
      "titleL": {
        "sizeSp": 24,
        "weight": 650,
        "width": 100,
        "tracking": -0.022,
        "use": "Tab title"
      },
      "titleM": {
        "sizeSp": 21,
        "weight": 650,
        "width": 100,
        "tracking": -0.022,
        "use": "Pushed screen title"
      },
      "section": {
        "sizeSp": 19,
        "weight": 650,
        "width": 100,
        "tracking": -0.015,
        "use": "Section heading"
      },
      "button": {
        "sizeSp": 17,
        "weight": 600,
        "width": 100,
        "tracking": -0.005,
        "use": "Primary button"
      },
      "body": {
        "sizeSp": 16,
        "weight": 400,
        "width": 100,
        "tracking": 0,
        "use": "Text"
      },
      "bodyStrong": {
        "sizeSp": 16,
        "weight": 600,
        "width": 100,
        "tracking": 0,
        "use": "Row title"
      },
      "label": {
        "sizeSp": 15,
        "weight": 600,
        "width": 100,
        "tracking": 0,
        "use": "Text buttons"
      },
      "caption": {
        "sizeSp": 13.5,
        "weight": 400,
        "width": 100,
        "tracking": 0,
        "use": "Row subtitle"
      },
      "micro": {
        "sizeSp": 12,
        "weight": 500,
        "width": 100,
        "tracking": 0,
        "use": "Nav label, chart axis; never smaller"
      }
    },
    "numerals": "Tabular lining figures everywhere a number can change."
  },
  "spacing": {
    "xxs": 3,
    "xs": 6,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "xxl": 28,
    "gutter": 20,
    "listGap": 0,
    "sectionGap": 28,
    "minTouch": 48,
    "tileGap": 8
  },
  "radius": {
    "plate": 9,
    "bar": 4,
    "tile": 20,
    "card": 22,
    "sheet": 28,
    "button": 28,
    "chip": 22,
    "note": "Buttons, chips and switches are full pills. Check, rank badge and stat markers are circles."
  },
  "elevation": {
    "rule": "Light: one soft shadow on cards. Dark: tone only, no shadows. Sheets use the scrim.",
    "lightCard": "0 1dp 2dp #16182009, 0 10dp 26dp -14dp #16182029",
    "darkCard": "none"
  },
  "iconography": {
    "strokeDp": 1.75,
    "cap": "round",
    "join": "round",
    "sizes": [
      18,
      20,
      22,
      24
    ]
  },
  "motion": {
    "duration": {
      "press": 90,
      "fast": 150,
      "standard": 240,
      "plateSeat": 320,
      "sheet": 280
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "exit": "cubic-bezier(0.3, 0, 1, 1)",
      "plateSeat": "cubic-bezier(0.16, 1, 0.3, 1)"
    },
    "signature": "A plate slides along the sleeve and seats with one haptic. The session dial runs down with the clock.",
    "reduceMotion": "Plates appear in place. The dial steps once a minute. Sheets crossfade."
  }
}